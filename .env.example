# Loveship : variables d'environnement (serveur uniquement, jamais préfixées VITE_).
# Copier vers .env.local pour le développement ; sur Vercel, les définir dans Project Settings > Environment Variables.
# Ce fichier ne contient aucune valeur réelle.

# Hash scrypt du mot de passe (format scrypt:N:r:p:sel:hash). Génération (saisie masquée) :
#   npm run hash-password
# Changer le mot de passe invalide toutes les sessions existantes.
LOVESHIP_PASSWORD_HASH=

# Secret de signature des sessions, 32 caractères minimum, aléatoire. Génération :
#   openssl rand -base64 48
# Le faire tourner invalide toutes les sessions existantes.
LOVESHIP_SESSION_SECRET=

# Vercel Blob privé (contenus définitifs). Optionnel en local : sans lui, le contenu placeholder du dépôt est servi.
# Sur Vercel, connecter le store au projet injecte BLOB_STORE_ID / VERCEL_OIDC_TOKEN (aucune valeur à saisir) ;
# en local ou pour `npm run upload-asset`, `vercel env pull .env.local` ou un jeton de store :
BLOB_READ_WRITE_TOKEN=

